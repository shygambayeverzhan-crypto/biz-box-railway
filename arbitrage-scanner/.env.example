BOT_TOKEN=
DATABASE_PATH=./data/bot.sqlite3
# Optional AI chat (paid OpenAI API usage; separate from Codex credits)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
AI_DAILY_LIMIT=25
AI_USER_DAILY_LIMIT=5
AI_MAX_OUTPUT_TOKENS=250
# Kazakhstan regional public spot APIs; no exchange API keys required
BYBIT_BASE_URL=https://api.bybit.kz
ATAIX_BASE_URL=https://api.ataix.kz
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT
SCAN_INTERVAL_SECONDS=5
ORDERBOOK_DEPTH=50
MAX_NOTIONAL_USDT=100
MIN_NET_SPREAD_PERCENT=0.50
MAX_QUOTE_AGE_SECONDS=4
MAX_CROSS_EXCHANGE_SKEW_SECONDS=2
MAX_SIGNAL_AGE_SECONDS=20
# Estimates only; confirm current venue fees. 0.10 means 0.10%.
BYBIT_TAKER_FEE_PERCENT=0.10
ATAIX_TAKER_FEE_PERCENT=0.20
COOLDOWN_SECONDS=300
