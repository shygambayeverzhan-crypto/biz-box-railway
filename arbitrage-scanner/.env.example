BOT_TOKEN=
DATABASE_PATH=./data/bot.sqlite3
# Kazakhstan Bybit public REST API
BYBIT_BASE_URL=https://api.bybit.kz
# Binance Global public market-data-only REST API; this is not asserted to be Binance Kazakhstan's order book
BINANCE_BASE_URL=https://data-api.binance.vision
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT
SCAN_INTERVAL_SECONDS=5
ORDERBOOK_DEPTH=50
MAX_NOTIONAL_USDT=100
MIN_NET_SPREAD_PERCENT=0.50
MAX_QUOTE_AGE_SECONDS=4
MAX_CROSS_EXCHANGE_SKEW_SECONDS=2
MAX_SIGNAL_AGE_SECONDS=20
# Estimates only; set values matching the assumed taker fees. 0.10 means 0.10%.
BYBIT_TAKER_FEE_PERCENT=0.10
BINANCE_TAKER_FEE_PERCENT=0.10
COOLDOWN_SECONDS=300

